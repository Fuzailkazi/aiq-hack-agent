# Copy to .env (never commit .env)
TYPESAFE_API_KEY=            # Jev (TypeSafe); not needed with HACKEVAL_SECOND_OPINION=none
HACKEVAL_SECOND_OPINION=jev  # jev, or none: the LLM scores and a human reviews every result
GOOGLE_API_KEY=              # Gemini (HACKEVAL_LLM_PROVIDER=gemini)
OPENAI_API_KEY=              # OpenAI (HACKEVAL_LLM_PROVIDER=openai)
GITHUB_TOKEN=                # optional: clone private repos
HACKEVAL_LLM_PROVIDER=gemini
HACKEVAL_DB_PATH=workspace/hackeval.db
HACKEVAL_WORKSPACE=workspace
HACKEVAL_CONFIG_DIR=config
HACKEVAL_INTAKE=intake.yaml          # CSV column mapping; intake.flow_state.yaml for the Flow State Google Form
HACKEVAL_HACKATHON=          # default --hackathon for CLI commands
# Sign in with Google (no shared token): an OAuth "Web application" client whose redirect URI is
# <HACKEVAL_PUBLIC_URL>/api/auth/google/callback. Only HACKEVAL_ALLOWED_EMAILS can sign in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HACKEVAL_ALLOWED_EMAILS=fuzail@armoriq.io,isha@armoriq.io
HACKEVAL_SESSION_SECRET=     # long random string, e.g. openssl rand -hex 32
HACKEVAL_PUBLIC_URL=http://127.0.0.1:8000
# Throughput (defaults shown): submissions in parallel, LLM calls in flight, ffmpeg/LibreOffice jobs
# HACKEVAL_CONCURRENCY=4
# HACKEVAL_LLM_CONCURRENCY=4
# HACKEVAL_CPU_CONCURRENCY=2
# Automatic Google Form sync (see docs/runbook.md): the responses sheet shared (Viewer) with a service account.
HACKEVAL_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=  # path to the service account JSON key, kept outside the repo
# HACKEVAL_SYNC_INTERVAL_MIN=5
# HACKEVAL_AUTO_SCORE=false   # true also scores new teams after each sync (spends model quota)
